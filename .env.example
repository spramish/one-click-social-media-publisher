# ===========================================================================
# One-Click Social Media Video Publisher — Environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Author: Pramish Sharma
# ===========================================================================

# --- Application ------------------------------------------------------------
PROJECT_NAME="One-Click Social Media Video Publisher"
ENVIRONMENT=development
DEBUG=true

# --- Security ---------------------------------------------------------------
# Generate a strong value, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# REQUIRED: the backend refuses to start with ENVIRONMENT=production while this
# placeholder (or any value shorter than 32 characters) is still in place.
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=12
# bcrypt work factor (12 = OWASP minimum; raise for higher-value accounts).
PASSWORD_HASH_ROUNDS=12
# Oldest sessions are revoked once a user exceeds this many active logins.
MAX_ACTIVE_SESSIONS=10
JWT_ALGORITHM=HS256
JWT_ISSUER=one-click-social-media-video-publisher
JWT_AUDIENCE=one-click-social-media-video-publisher-api

# --- Refresh-token cookie ---------------------------------------------------
# The refresh token is only ever sent as an HttpOnly cookie, never in JSON.
REFRESH_COOKIE_NAME=ocp_refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
# MUST be true (and the site served over HTTPS) in production.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=.example.com

# --- Backend ----------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=publisher
POSTGRES_PASSWORD=publisher_dev_password
POSTGRES_DB=publisher_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# SQLAlchemy URL (psycopg v3 driver). Inside Docker the host is "postgres";
# when running the backend directly on Windows use "localhost".
DATABASE_URL=postgresql+psycopg://publisher:publisher_dev_password@postgres:5432/publisher_db

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Celery -----------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Frontend ---------------------------------------------------------------
# Must be reachable from the browser, so use localhost (not the docker hostname).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Email ------------------------------------------------------------------
# "console" logs messages (development only — it refuses to run in production).
# "smtp" delivers them through the relay below.
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=One-Click Publisher
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
# Base URL used to build the links inside verification/reset emails.
FRONTEND_BASE_URL=http://localhost:3000

# --- Media storage (Phase 5) ------------------------------------------------
# Where uploaded videos and thumbnails live for the "local" storage backend.
# A relative path resolves against the process working directory ("backend/").
MEDIA_ROOT=var/media
# Largest accepted upload (default 2 GiB).
MEDIA_MAX_UPLOAD_BYTES=2147483648
# Accepted container types. Anything else is refused before bytes are written.
MEDIA_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska,video/x-msvideo
# Chunk size for the resumable upload protocol (default 5 MiB).
MEDIA_CHUNK_SIZE_BYTES=5242880
# How long an unfinished upload stays resumable.
MEDIA_UPLOAD_SESSION_TTL_HOURS=6
# Lifetime of a signed media URL (default 15 minutes).
MEDIA_SIGNED_URL_TTL_SECONDS=900
# Widest generated thumbnail; the height keeps the aspect ratio.
MEDIA_THUMBNAIL_MAX_WIDTH=640
# FFmpeg binaries. Set absolute paths when they are not on PATH, e.g.
#   MEDIA_FFMPEG_BINARY=C:\Users\you\AppData\Local\ffmpeg\ffmpeg-7.1-essentials_build\bin\ffmpeg.exe
MEDIA_FFMPEG_BINARY=ffmpeg
MEDIA_FFPROBE_BINARY=ffprobe
MEDIA_FFMPEG_TIMEOUT_SECONDS=120

# --- OAuth account connections (Phase 6) ------------------------------------
# Public origin the *browser* reaches this API on. Every OAuth redirect_uri is
# built from it, so it MUST match the value registered with each platform to
# the character (scheme, host, port, and path).
BACKEND_PUBLIC_URL=http://localhost:8000
# Where the browser is sent once a connection succeeds / fails.
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/accounts
OAUTH_FAILURE_REDIRECT=http://localhost:3000/accounts
# How long an authorization attempt may stay open (seconds).
OAUTH_STATE_TTL_SECONDS=600
# Wall-clock limit for one platform API call (seconds).
OAUTH_HTTP_TIMEOUT_SECONDS=30
# Refresh a token this many seconds before it actually expires.
OAUTH_REFRESH_MARGIN_SECONDS=300
# Optional dedicated key for encrypting tokens at rest. When empty, a key is
# derived from SECRET_KEY under a distinct HKDF context. Set a long random value
# in production so token encryption survives a SECRET_KEY rotation.
OAUTH_ENCRYPTION_KEY=

# --- Meta (Facebook + Instagram Graph API) ----------------------------------
# One Meta app usually serves both Facebook and Instagram; the Facebook pair
# wins, and the Instagram pair is the documented fallback. See docs/OAUTH_SETUP.md.
META_GRAPH_VERSION=v21.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- Google (YouTube Data API v3) -------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok (Login Kit + Content Posting API) -------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- AI content generation (Phase 9) ----------------------------------------
# Server-side only. The key is never sent to the browser, logged, or echoed in
# a response. When it is empty, the AI assistant reports "not configured" and
# generation answers 503 — nothing else breaks.
OPENAI_API_KEY=
# Point at a compatible gateway/proxy if you are not calling OpenAI directly.
OPENAI_BASE_URL=https://api.openai.com/v1
# Default model; any chat-completions model works.
OPENAI_MODEL=gpt-4o-mini
# Wall-clock limit for one model call (seconds).
OPENAI_HTTP_TIMEOUT_SECONDS=60
# Upper bound on generated tokens per request.
OPENAI_MAX_OUTPUT_TOKENS=800
# Sampling temperature (0 = deterministic, 2 = most random).
OPENAI_TEMPERATURE=0.8
# Longest brief the API accepts (characters).
AI_MAX_BRIEF_CHARS=2000

# --- Analytics dashboard (Phase 10) -----------------------------------------
# No credentials are needed: metrics are read through the *same* platform
# connections created in Phase 6 (their tokens are reused). These knobs only
# bound one refresh; every setting has a working default.
# Wall-clock limit for a single platform metrics call (seconds). Shorter than the
# publishing timeout — a refresh reads numbers, it does not upload a video.
ANALYTICS_HTTP_TIMEOUT_SECONDS=30
# Default look-back window for the historical performance chart (days).
ANALYTICS_DEFAULT_WINDOW_DAYS=30
# Ceiling on the number of daily points the history endpoint returns, so an
# over-wide window cannot become an unbounded query or payload.
ANALYTICS_MAX_HISTORY_POINTS=180
# How many published targets / connected accounts a single refresh may pull,
# bounding one request's work and outbound API calls.
ANALYTICS_MAX_REFRESH_TARGETS=200

# --- Notifications (Phase 11) -----------------------------------------------
# In-app notifications are always recorded; the per-user email switches in
# Settings only decide whether a *copy* is also mailed. Email delivery reuses the
# EMAIL_BACKEND above (console in development, smtp in production) and runs on
# Celery Beat. Every setting has a working default.
# How often Beat runs the delivery sweep (seconds). Bounds how late an email
# copy can be; the in-app row is written immediately and is never delayed.
NOTIFICATIONS_SWEEP_INTERVAL_SECONDS=60
# Pending notifications considered per sweep, bounding one tick's work.
NOTIFICATIONS_EMAIL_BATCH_SIZE=100
# How far ahead of a scheduled post the reminder fires (seconds; default 1 hour).
NOTIFICATIONS_REMINDER_LEAD_SECONDS=3600
# Warn once when a connected account's token expires within this many days.
NOTIFICATIONS_TOKEN_WARNING_DAYS=7

# --- AI model management & failover (Phase 12) ------------------------------
# Generation flows through a router that walks an admin-managed model list in
# priority order and fails over to the next on error. Manage the list at
# /ai-models (needs the "ai:manage" permission). Every setting has a default.
# Retries per model before the router switches to the next one.
AI_ROUTER_MAX_ATTEMPTS=2
# Exponential backoff base between retries (seconds).
AI_ROUTER_BACKOFF_BASE_SECONDS=1.0
# Backoff ceiling (seconds).
AI_ROUTER_BACKOFF_MAX_SECONDS=8.0
# How often Celery Beat probes each model's health (seconds).
AI_HEALTH_CHECK_INTERVAL_SECONDS=600
# Local Ollama server — only needed for a model of kind "ollama" (no API key).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# --- Security hardening (Phase 13) ------------------------------------------
# Per-route request limits, applied to the surfaces worth protecting: the
# credential endpoints (where a guesser would otherwise be free) and AI
# generation (where every call costs money or quota). Counters live in Redis so
# the limit is shared across workers; if Redis is down the limiter degrades to
# an in-process counter instead of failing open. Set RATE_LIMIT_ENABLED=false to
# disable entirely (the automated test suite does this).
RATE_LIMIT_ENABLED=true
# The fixed window every limit below is measured over (seconds).
RATE_LIMIT_WINDOW_SECONDS=60
# Requests per window, per caller address, shared across login/register/reset.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Requests per window, per caller address, for AI generation.
RATE_LIMIT_AI_PER_MINUTE=30


