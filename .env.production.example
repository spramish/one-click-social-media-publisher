# ===========================================================================
# Production environment template — One-Click Social Media Video Publisher
# Copy to ".env" ON THE SERVER and fill in every REQUIRED value.
# Author: Pramish Sharma
#
# This lists only what differs from .env.example — start from that file, then
# apply the changes below. See docs/DEPLOYMENT.md.
# ===========================================================================

# --- Application ------------------------------------------------------------
# Both switches matter: DEBUG=true leaks tracebacks to clients, and
# ENVIRONMENT=production is what makes config.py enforce the guards below.
ENVIRONMENT=production
DEBUG=false

# --- Security ---------------------------------------------------------------
# REQUIRED. Boot fails if this is still the placeholder or shorter than 32 chars.
#   openssl rand -base64 48
SECRET_KEY=REPLACE_WITH_A_RANDOM_VALUE

# REQUIRED. Boot fails if the cookie is not marked Secure. Set a long random
# value so OAuth tokens survive a SECRET_KEY rotation.
OAUTH_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_VALUE

# --- Refresh-token cookie ---------------------------------------------------
# REQUIRED (guarded): the refresh cookie is only sent over HTTPS.
REFRESH_COOKIE_SECURE=true
# Keep "lax" when the frontend and API share a site (api.example.com /
# www.example.com). Use "none" only when they are on genuinely different sites —
# "none" requires Secure, which is already enforced above.
REFRESH_COOKIE_SAMESITE=lax
# Uncomment to share the cookie across subdomains.
# REFRESH_COOKIE_DOMAIN=.example.com

# --- Backend ----------------------------------------------------------------
# The browser's origin, comma-separated. The CSRF origin guard refuses
# state-changing requests from anything not listed here.
CORS_ORIGINS=https://www.example.com
# Public URLs are baked into OAuth redirect_uri values, so they must match what
# is registered with each platform, character for character.
BACKEND_PUBLIC_URL=https://api.example.com

# --- PostgreSQL -------------------------------------------------------------
# REQUIRED: the compose stack refuses to start without a password.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Point at a managed instance instead and drop the postgres service; the URL
# must use the psycopg v3 driver scheme.
DATABASE_URL=postgresql+psycopg://publisher:REPLACE_WITH_A_STRONG_PASSWORD@postgres:5432/publisher_db

# --- Frontend ---------------------------------------------------------------
# REQUIRED and public: it is compiled into the client bundle at image build time.
NEXT_PUBLIC_API_URL=https://api.example.com

# --- Email ------------------------------------------------------------------
# "console" refuses to run in production, so a real relay is REQUIRED for
# verification and password-reset mail to be delivered.
EMAIL_BACKEND=smtp
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_USE_STARTTLS=true
FRONTEND_BASE_URL=https://www.example.com

# --- OAuth callbacks --------------------------------------------------------
# Must be the public frontend origin; these are where the browser lands.
OAUTH_SUCCESS_REDIRECT=https://www.example.com/accounts
OAUTH_FAILURE_REDIRECT=https://www.example.com/accounts

# --- Sandbox mode -----------------------------------------------------------
# OPTIONAL. true makes every platform integration in-process (no developer app
# needed): connecting an account and publishing return simulated data. It is a
# demonstration aid only — config.py REFUSES TO BOOT with DEMO_MODE=true while
# ENVIRONMENT=production, so leave it false on any real deployment.
DEMO_MODE=false

# --- Error tracking (Phase 15) ----------------------------------------------
# Empty disables Sentry entirely. Set the DSN to capture unhandled exceptions.
SENTRY_DSN=
# 0.0 keeps a free tier quiet; errors are still captured. Try 0.1 to sample.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Capacity ---------------------------------------------------------------
# One gunicorn supervisor per API container; 2 x CPU cores is a safe start.
WEB_CONCURRENCY=4
