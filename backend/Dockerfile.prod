# ---------------------------------------------------------------------------
# Backend production image — One-Click Social Media Video Publisher
# Author: Pramish Sharma
#
# Multi-stage: wheels are built once with the compilers, then only the virtual
# environment and the runtime libraries (ffmpeg, libpq) ship in the final image.
# Runs as a non-root user; migrations are applied on start, then gunicorn
# supervises uvicorn workers.
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:$PATH"

# ffmpeg drives the video pipeline; libpq5 is psycopg's runtime library; curl
# backs the container healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 appuser

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=appuser:appuser . .

# Uploaded media and thumbnails live on a volume so they survive a rebuild.
RUN mkdir -p /app/var/media && chown -R appuser:appuser /app/var

USER appuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8000/api/v1/health || exit 1

# ``alembic upgrade head`` is idempotent, so restarting a container is safe.
# WEB_CONCURRENCY is sized to the container's CPU share (default 2).
CMD ["sh", "-c", "alembic upgrade head && exec gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --workers ${WEB_CONCURRENCY:-2} --bind 0.0.0.0:8000 --access-logfile - --error-logfile - --timeout 120"]
