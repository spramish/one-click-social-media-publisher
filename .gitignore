# ---------------------------------------------------------------------------
# One-Click Social Media Video Publisher — Git ignore rules
# Author: Pramish Sharma
# ---------------------------------------------------------------------------

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!.env.production.example

# Deployment secrets and artefacts (Phase 15)
deploy/certs/
backups/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
logs/

# Local storage / uploaded media (dev only)
storage/
media/
uploads/
var/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
